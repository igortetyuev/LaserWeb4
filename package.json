{
  "name": "laserweb",
  "version": "4.1.0",
  "description": "LaserWeb",
  "main": "electron/main.js",
  "scripts": {
    "electron": "env -u ELECTRON_RUN_AS_NODE electron .",
    "start-server": "node node_modules/lw.comm-server/server.js",
    "start-app": "webpack serve --mode development --open",
    "start-prod": "webpack serve --mode production --open",
    "start": "npm-run-all -p -r start-app start-server",
    "bundle-dev": "webpack --mode development",
    "bundle-prod": "webpack --mode production",
    "build-docs": "jsdoc -c ./jsdoc.json",
    "installdev": "git submodule init && git submodule update --remote && npm install && npm update lw.comm-server",
    "golive": "git checkout gh-pages && git pull && git merge dev-es6 && npm run bundle-dev && git add dist && git commit -m regen && git push && git checkout dev-es6",
    "start-electron": "npm run bundle-prod && env -u ELECTRON_RUN_AS_NODE electron .",
    "dist": "npm run bundle-prod && electron-builder"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LaserWeb/LaserWeb4.git"
  },
  "keywords": [
    "laser",
    "cnc",
    "cam",
    "..."
  ],
  "author": "Peter van der Walt <peter.plaaswerf@gmail.com>",
  "contributors": [
    "Peter van der Walt <peter.plaaswerf@gmail.com>",
    "S\u00e9bastien Mischler <sebastien@onlfait.ch>",
    "Jo\u00e3o Matos <joao@tritao.eu>",
    "Todd Fleming <jscut.org>",
    "Jorge Robles <jorge.diego.robles@gmail.com>",
    "Claudio Prezzi <cprezzi@comsulting.ch>"
  ],
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/LaserWeb/LaserWeb4/issues"
  },
  "homepage": "https://laserweb.yurl.ch",
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@babel/preset-env": "7.29.14",
    "@babel/preset-react": "7.29.7",
    "ajv": "8.20.0",
    "ajv-draft-04": "1.0.0",
    "array-move": "^1.0.0",
    "aruco-marker": "^2.0.0",
    "babel-loader": "9.2.1",
    "bootstrap": "5.3.9",
    "buffer": "6.0.3",
    "chunk": "0.0.2",
    "clipper-lib": "^6.2.1",
    "color-convert": "^1.9.0",
    "css-loader": "6.11.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "flat": "^2.0.1",
    "floyd-steinberg": "^1.0.6",
    "font-awesome": "^4.6.3",
    "gamepad.js": "git+https://github.com/neogeek/gamepad.js.git#d3f8f96e79",
    "gl-matrix": "^2.3.2",
    "hhmmss": "^1.0.0",
    "imports-loader": "4.0.1",
    "jquery": "^3.4.1",
    "json-stringify-pretty-compact": "^1.0.2",
    "keyboardjs": "^2.5.1",
    "lw.canvas-filters": "git+https://github.com/LaserWeb/lw.canvas-filters.git",
    "lw.canvas-grid": "git+https://github.com/LaserWeb/lw.canvas-grid.git",
    "lw.raster-to-gcode": "git+https://github.com/LaserWeb/lw.raster-to-gcode.git",
    "lw.svg-curves": "^0.1.0",
    "lw.svg-path": "^0.1.0",
    "marked": "^0.3.9",
    "npm-run-all": "^4.1.5",
    "object-to-string": "^1.0.0",
    "poly2tri": "^1.3.5",
    "prefix-keys": "^1.0.0",
    "prop-types": "15.8.1",
    "queue": "^4.5.1",
    "raw-loader": "4.0.2",
    "react": "18.3.1",
    "react-bootstrap": "2.10.10",
    "react-dom": "18.3.1",
    "react-draggable": "4.7.2",
    "react-redux": "8.1.3",
    "react-rnd": "10.5.3",
    "react-select": "5.10.2",
    "redux": "4.2.1",
    "redux-localstorage": "^1.0.0-rc5",
    "redux-localstorage-filter": "^0.1.1",
    "redux-logger": "^3.0.6",
    "script-loader": "0.7.2",
    "sillyname": "^0.1.0",
    "slug": "^0.9.4",
    "snapsvg": "^0.5.1",
    "socket.io-client": "4.x",
    "style-loader": "3.3.4",
    "uuid": "^3.3.3",
    "validatorjs": "^3.17.1",
    "vex-js": "^3.1.0",
    "web-cam-cpp": "git+https://github.com/LaserWeb/web-cam-cpp.git",
    "webpack": "5.112.2",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "5.2.7",
    "webrtc-adapter": "^3.1.5",
    "worker-loader": "3.0.8",
    "xregexp": "^4.2.4"
  },
  "dependencies": {
    "dxf-parser": "^0.4.8",
    "hoek": "^5.0.3",
    "immutability-helper": "^2.9.1",
    "lw.comm-server": "file:vendor/lw.comm-server",
    "object.omit": "^3.0.0",
    "unicode": "^9.0.0",
    "vectorize-text": "^3.2.1"
  },
  "allowScripts": {
    "@serialport/bindings-cpp@13.0.0": true,
    "node-hid@3.4.0": true,
    "fsevents@2.3.3": true
  },
  "build": {
    "appId": "xyz.laserweb",
    "productName": "LaserWeb",
    "asar": true,
    "files": [
      "dist/**",
      "electron/**",
      "vendor/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.graphics-design"
    },
    "directories": {
      "output": "release"
    }
  }
}
